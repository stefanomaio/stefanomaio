# Postgres connection string (Neon, Supabase, or any other Postgres host).
# The app uses this one at runtime — a pooled connection is fine and preferred.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Optional: a *direct*, non-pooled connection string, used only by
# `prisma migrate deploy` (see prisma.config.ts). Migrations take a
# session-level advisory lock that connection poolers (Neon's pooler,
# PgBouncer in transaction mode, etc.) don't support and will time out on.
# Neon's Vercel integration sets this automatically. If your host doesn't
# provide a separate direct URL, omit this — migrations will fall back to
# DATABASE_URL, which is fine as long as that isn't a pooled connection.
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"

# Shared password for the /moderate review page. Set this to something
# real before deploying — without it, moderation is disabled.
MODERATION_PASSWORD="change-me"

# Used to sign the moderator session cookie. Set to a long random string
# in production; falls back to MODERATION_PASSWORD in dev if unset.
MODERATION_SECRET="change-me-too"
